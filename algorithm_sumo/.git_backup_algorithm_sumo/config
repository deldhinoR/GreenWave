[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/deldhinoR/GreenWave_Development.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "merged_last"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/merged_last
